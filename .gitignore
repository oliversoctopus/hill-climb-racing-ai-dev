# =============================================================================
# Root .gitignore
# =============================================================================

# --- Python virtualenv & bytecode caches ---
python/.venv/
__pycache__/
*.pyc
*.pyo

# --- Training outputs: regrow fast (~81 checkpoints/run) and are large ---
python/checkpoints/
python/tb/
python/logs/

# --- IDE ---
.idea/

# --- Committed experiment/probe result artifacts (large, regenerable) ---
*.npz
*.evallog
*.log
*.csv
python/diagnostics/p5_sweep_logs/
python/autorun/backtrack_runs/

# Note: analysis_artifacts/ is intentionally KEPT (tracked) despite its size.
